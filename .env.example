APP_PORT=3000
APP_ENV=dev
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=30
BETA_INVITE_CODES=123456

NODE_IMAGE=node:24-alpine
POSTGRES_IMAGE=pgvector/pgvector:pg17
REDIS_IMAGE=redis:8-alpine

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_DEFAULT=deepseek-v4-pro
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

MEMORY_CHAR_LIMIT=2200
USER_MEMORY_CHAR_LIMIT=1375
MEMORY_DIR=.my-agent/memories
MEMORY_REVIEW_INTERVAL=10

FILE_WORKSPACE_DIR=.my-agent/workspaces
ARTIFACT_STORAGE_DIR=.my-agent/artifacts

SKILL_STORAGE_DIR=.my-agent/skills
SKILL_REVIEW_INTERVAL=10
# 可选。GitHub Skill 安装包总大小上限，默认 8388608（8 MiB）。
SKILL_MAX_TOTAL_BYTES=8388608
# 可选。优先使用 SKILL_GITHUB_TOKEN；也兼容常见的 GITHUB_TOKEN。
SKILL_GITHUB_TOKEN=
GITHUB_TOKEN=

LANGFUSE_SECRET_KEY=replace-with-your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=replace-with-your-langfuse-public-key
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

POSTGRES_USER=my_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=my_agent
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgres://my_agent:change-me@db:5432/my_agent

REDIS_URL=redis://redis:6379
NEXT_TELEMETRY_DISABLED=1

# Web tools
# WEB_PROVIDER 是 search/extract 的共享默认后端；也可以分别设置 WEB_SEARCH_PROVIDER / WEB_EXTRACT_PROVIDER。
# 默认使用 Firecrawl 官方免费入口；未显式配置 provider 时，自动选择顺序与 Hermes 保持一致。
WEB_PROVIDER=firecrawl
WEB_SEARCH_PROVIDER=
WEB_SEARCH_FALLBACK_PROVIDER=ddgs
WEB_EXTRACT_PROVIDER=
WEB_SEARCH_DEFAULT_LIMIT=5
# 搜索结果中出现 GitHub 仓库 URL 时，最多自动补充多少个仓库的 GitHub API 元数据。设为 0 可关闭。
WEB_SEARCH_GITHUB_ENRICH_LIMIT=10
WEB_SEARCH_TIMEOUT_MS=30000
WEB_EXTRACT_TIMEOUT_MS=60000
WEB_EXTRACT_MIN_LENGTH=5000
WEB_EXTRACT_MAX_CHARS=5000
WEB_EXTRACT_SUMMARIZER_MODEL=
WEB_ALLOW_PRIVATE_URLS=false
WEB_DDGS_ENABLED=true

FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
PARALLEL_API_KEY=
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
EXA_API_KEY=
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
